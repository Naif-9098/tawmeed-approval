<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<title>مستخلص أعمال <%= cert.cert_no %></title>
<link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;900&family=IBM+Plex+Sans+Arabic:wght@400;500;600&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<style>
  :root{ --ink:#111315; --line:#111315; --line-soft:#B9BEC4; --grey-label:#EAEAEA; --amber:#E8960C; --navy:#16233A; --good:#1E7D4B; --bad:#B3261E; }
  *{box-sizing:border-box;}
  body{font-family:'IBM Plex Sans Arabic','Tajawal',sans-serif; color:var(--ink); margin:0; padding:24px; background:#fff;}
  .mono{font-family:'JetBrains Mono',monospace;}
  .toolbar{text-align:center; margin-bottom:16px;}
  .toolbar button{font-family:'Tajawal'; font-weight:700; background:var(--amber); color:var(--navy); border:none; padding:10px 22px; border-radius:6px; cursor:pointer;}
  .sheet{max-width:900px; margin:0 auto; border:1.5px solid var(--line); border-radius:2px;}
  .head-row{display:grid; grid-template-columns:1fr 1fr 1fr; border-bottom:2.5px solid var(--line); padding:14px 16px; align-items:center;}
  .head-row h2{font-family:'Tajawal'; font-weight:900; font-size:24px; margin:0; text-align:left;}
  .certno{text-align:center; font-family:'JetBrains Mono'; font-weight:700; color:var(--bad); font-size:16px;}
  .info-grid{display:grid; grid-template-columns:1fr 2fr 1fr 2fr; font-size:13.5px;}
  .info-grid .lbl{background:var(--grey-label); border-bottom:1px solid var(--line-soft); border-left:1px solid var(--line-soft); padding:8px 10px; font-weight:700; text-align:right;}
  .info-grid .val{border-bottom:1px solid var(--line-soft); border-left:1px solid var(--line-soft); padding:8px 10px;}
  table{width:100%; border-collapse:collapse; margin:16px 0;}
  thead th{border:1px solid var(--line); font-size:12.5px; padding:8px; text-align:center;}
  tbody td{border:1px solid var(--line-soft); padding:7px; text-align:center; font-size:13px;}
  .section-title{font-family:'Tajawal'; font-weight:900; font-size:17px; margin:20px 16px 8px;}
  .totals-block{padding:0 16px;}
  .totals-block .row{display:flex; justify-content:space-between; border-bottom:1px solid var(--line-soft); padding:7px 2px; font-size:13.5px;}
  .totals-block .row.final{font-weight:900; font-size:15px; border-bottom:2px solid var(--line);}
  .box{margin:0 16px 16px; padding:10px 14px; border:1px solid var(--line-soft); border-radius:4px; font-size:13.5px; white-space:pre-wrap; min-height:50px;}
  .bottom-summary{border-top:2px solid var(--line); margin-top:10px; padding:14px 16px;}
  .bottom-summary .row{display:flex; justify-content:space-between; padding:6px 0; font-size:13.5px;}
  .bottom-summary .row.final{font-weight:900; font-size:16px; border-top:2px solid var(--line); margin-top:6px; padding-top:10px;}
  .sig-area{display:grid; grid-template-columns:1fr 1fr; border-top:2px solid var(--line); margin-top:10px;}
  .sig-cell{padding:18px 16px; text-align:center;}
  .sig-cell + .sig-cell{border-right:1px solid var(--line-soft);}
  .sig-pending{color:#888; font-weight:700; border:2px dashed var(--line-soft); border-radius:6px; padding:14px;}
  .sig-approved{border:2px solid var(--good); border-radius:6px; padding:14px;}
  .sig-approved .tick{color:var(--good); font-weight:900; font-size:15px; margin-bottom:6px;}
  .sig-approved .line{font-size:12.5px; margin:2px 0;}
  .status-line{text-align:center; font-weight:800; padding:8px; font-size:13px; background:#FAFAFA; border-bottom:1px solid var(--line-soft);}
  @media print{ .toolbar{display:none;} body{padding:0;} .sheet{border:none;} }
</style>
</head>
<body>
  <div class="toolbar"><button onclick="window.print()">🖨 طباعة / حفظ كـ PDF</button></div>
  <div class="sheet">
    <div class="head-row">
      <div class="certno">رقم المستخلص<br><%= cert.cert_no %></div>
      <div style="text-align:center; font-size:11px; color:#666;">PAYMENT CERTIFICATE</div>
      <h2>مستخلص أعمال</h2>
    </div>
    <div class="status-line">الحالة: <%= statusLabels[cert.status] %> — الحالة المالية: <%= financialStatusLabels[cert.financial_status] %></div>

    <div class="info-grid">
      <div class="lbl">التاريخ:</div><div class="val mono"><%= cert.cert_date ? new Date(cert.cert_date).toISOString().slice(0,10) : '' %></div>
      <div class="lbl">رقم أمر التعميد:</div><div class="val mono"><%= order.project_order_no || order.order_no %></div>
      <div class="lbl">المشروع:</div><div class="val"><%= order.project_name_rel || order.project_name || '' %></div>
      <div class="lbl">مسؤول المشروع:</div><div class="val"><%= order.project_manager || '' %></div>
      <div class="lbl">المقاول:</div><div class="val"><%= order.contractor_name || '' %></div>
      <div class="lbl">الكود:</div><div class="val mono"><%= order.code || '' %></div>
      <div class="lbl">طريقة الدفع:</div><div class="val"><%= payMethodLabels[cert.payment_method] || '' %></div>
      <div class="lbl">&nbsp;</div><div class="val"></div>
    </div>

    <table>
      <thead><tr><th style="width:60px;">رقم الدفعة</th><th>وصف الدفعة</th><th style="width:130px;">المبلغ</th></tr></thead>
      <tbody>
        <% items.forEach((it,i) => { %>
        <tr><td class="mono"><%= i+1 %></td><td style="text-align:right;"><%= it.description %></td><td class="mono"><%= Number(it.amount).toLocaleString('en-US',{minimumFractionDigits:2}) %></td></tr>
        <% }) %>
      </tbody>
    </table>

    <div class="totals-block">
      <div class="row"><span>الإجمالي:</span><span class="mono"><%= Number(cert.subtotal).toLocaleString('en-US',{minimumFractionDigits:2}) %></span></div>
      <div class="row"><span>الخصم:</span><span class="mono"><%= Number(cert.discount).toLocaleString('en-US',{minimumFractionDigits:2}) %></span></div>
      <div class="row"><span>الإجمالي بعد الخصم:</span><span class="mono"><%= Number(cert.after_discount).toLocaleString('en-US',{minimumFractionDigits:2}) %></span></div>
      <div class="row"><span>الضريبة (<%= cert.vat_rate %>%):</span><span class="mono"><%= Number(cert.vat_amount).toLocaleString('en-US',{minimumFractionDigits:2}) %></span></div>
      <div class="row final"><span>الإجمالي النهائي:</span><span class="mono"><%= Number(cert.grand_total).toLocaleString('en-US',{minimumFractionDigits:2}) %></span></div>
    </div>

    <div class="section-title">ملاحظات</div>
    <div class="box"><%= cert.notes || '' %></div>

    <div class="bottom-summary">
      <div class="row"><span>رقم المستخلص:</span><span class="mono"><%= cert.cert_no %></span></div>
      <div class="row"><span>إجمالي العقد / قيمة أمر التعميد:</span><span class="mono"><%= Number(order.grand_total).toLocaleString('en-US',{minimumFractionDigits:2}) %></span></div>
      <div class="row"><span>مجموع ما تم صرفه سابقًا:</span><span class="mono"><%= spent.toLocaleString('en-US',{minimumFractionDigits:2}) %></span></div>
      <div class="row"><span>إجمالي دفعة المستخلص الحالية:</span><span class="mono"><%= Number(cert.grand_total).toLocaleString('en-US',{minimumFractionDigits:2}) %></span></div>
      <div class="row"><span>قيمة الضريبة (إن وجدت):</span><span class="mono"><%= Number(cert.vat_amount).toLocaleString('en-US',{minimumFractionDigits:2}) %></span></div>
      <div class="row final"><span>الإجمالي النهائي:</span><span class="mono"><%= Number(cert.grand_total).toLocaleString('en-US',{minimumFractionDigits:2}) %></span></div>
      <div class="row"><span>المتبقي من أمر التعميد بعد هذا المستخلص:</span><span class="mono"><%= remaining.toLocaleString('en-US',{minimumFractionDigits:2}) %></span></div>
    </div>

    <div class="sig-area">
      <div class="sig-cell">
        <% if (cert.status === 'approved') { %>
          <div class="sig-approved">
            <div class="tick">✓ معتمد إلكترونيًا</div>
            <div class="line"><b>الاسم:</b> <%= cert.final_approved_by_name %></div>
            <% if (cert.final_approved_by_title) { %><div class="line"><b>المسمى الوظيفي:</b> <%= cert.final_approved_by_title %></div><% } %>
            <div class="line"><b>التاريخ:</b> <%= new Date(cert.final_approved_at).toLocaleDateString('en-CA') %></div>
            <div class="line"><b>الوقت:</b> <%= new Date(cert.final_approved_at).toLocaleTimeString('ar-SA') %></div>
          </div>
        <% } else { %>
          <div class="sig-pending">بانتظار الاعتماد الإلكتروني</div>
        <% } %>
        <div style="font-size:11px; color:#666; margin-top:6px;">مسؤول التعميد</div>
      </div>
      <div class="sig-cell">
        <div style="font-size:12.5px; color:#666;">المقاول</div>
        <div style="margin-top:24px; border-bottom:1px solid var(--line-soft); width:70%; margin-inline:auto;"></div>
      </div>
    </div>
  </div>
</body>
</html>
