<%- include('../partials/header', { title: mode === 'new' ? 'أمر تعميد جديد' : 'تعديل أمر التعميد' }) %>
<div class="wrap">
  <% if (project) { %>
    <%- include('../partials/breadcrumbs', { crumbs: [
      { label: 'المشاريع', url: '/projects' },
      { label: project.name, url: '/projects/' + project.id },
      { label: mode === 'new' ? 'أمر تعميد جديد' : 'تعديل أمر تعميد' }
    ] }) %>
  <% } %>
  <h2 class="page-title"><%= mode === 'new' ? 'أمر تعميد جديد' : 'تعديل أمر التعميد رقم ' + (order.project_order_no || order.order_no) %></h2>
  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
  <% if (mode === 'edit' && order.status === 'returned_for_edit') { %>
    <div class="alert alert-error">تمت إعادة هذا الأمر للتعديل من قبل المعتمد. راجع صفحة عرض الأمر لقراءة الملاحظة، ثم عدّل وأعد الإرسال.</div>
  <% } %>
  <% if (project) { %>
    <div class="project-banner">هذا الأمر مرتبط بمشروع: <b><%= project.name %></b> (<span class="mono"><%= project.code %></span>) — سيُولَّد له رقم تلقائي ضمن هذا المشروع.</div>
  <% } %>

  <form method="POST" action="<%= mode === 'new' ? '/orders/new' : '/orders/' + order.id + '/edit' %>">
    <% if (project) { %><input type="hidden" name="project_id" value="<%= project.id %>"><% } %>
    <div class="card">
      <div class="form-grid">
        <div class="form-field"><label>نطاق العمل</label><input name="scope" value="<%= order ? (order.scope||'') : '' %>"></div>
        <div class="form-field"><label>الكود</label><input name="code" value="<%= order ? (order.code||'') : '' %>"></div>
        <% if (!project) { %>
        <div class="form-field"><label>اسم المشروع</label><input name="project_name" value="<%= order ? (order.project_name||'') : '' %>"></div>
        <% } %>
        <div class="form-field"><label>مسؤول المشروع</label><input name="project_manager" value="<%= order ? (order.project_manager||'') : '' %>"></div>
        <div class="form-field"><label>رقم التواصل</label><input name="phone" value="<%= order ? (order.phone||'') : '' %>"></div>
        <div class="form-field"><label>المقاول / المورد</label><input name="contractor_name" value="<%= order ? (order.contractor_name||'') : '' %>"></div>
        <div class="form-field"><label>التاريخ</label><input type="date" name="order_date" value="<%= order && order.order_date ? new Date(order.order_date).toISOString().slice(0,10) : new Date().toISOString().slice(0,10) %>"></div>
        <div class="form-field"><label>نسبة الضريبة %</label><input type="number" step="any" name="vat_rate" id="vat-rate" value="<%= order ? order.vat_rate : 15 %>" oninput="calcAll()"></div>
      </div>
    </div>

    <div class="card">
      <h3 style="margin-top:0;">وصف الأعمال / البنود</h3>
      <div id="quick-picks" style="margin-bottom:12px; font-size:12px;"></div>
      <table>
        <thead><tr><th style="width:40px;">#</th><th>وصف البند</th><th style="width:90px;">الكمية</th><th style="width:90px;">الوحدة</th><th style="width:110px;">سعر الوحدة</th><th style="width:110px;">الإجمالي</th><th style="width:36px;"></th></tr></thead>
        <tbody id="items-body"></tbody>
      </table>
      <button type="button" class="add-row" onclick="addItemRow()">+ إضافة بند</button>
    </div>

    <div class="card">
      <h3 style="margin-top:0;">الالتزامات والشروط</h3>
      <div class="form-field"><textarea name="obligations_text" rows="5"><%= order ? (order.obligations_text||'') : '' %></textarea></div>
    </div>

    <div class="card">
      <h3 style="margin-top:0;">جدول الدفعات</h3>
      <table>
        <thead><tr><th style="width:40px;">#</th><th>وصف الدفعة</th><th style="width:90px;">النسبة %</th><th style="width:120px;">القيمة</th><th style="width:36px;"></th></tr></thead>
        <tbody id="pay-body"></tbody>
      </table>
      <button type="button" class="add-row" onclick="addPayRow()">+ إضافة دفعة</button>
      <div style="text-align:left; font-weight:700; margin-top:10px;">
        الإجمالي بدون الضريبة: <span class="mono" id="subtotal-disp">0.00</span> —
        الضريبة: <span class="mono" id="vat-disp">0.00</span> —
        المجموع: <span class="mono" id="grand-disp">0.00</span>
      </div>
    </div>

    <div style="display:flex; gap:10px;">
      <button type="submit" class="btn btn-primary">حفظ</button>
      <a href="<%= mode === 'new' ? '/orders' : '/orders/' + order.id %>" class="btn btn-ghost">إلغاء</a>
    </div>
  </form>
</div>

<!-- نافذة إضافة بند جديد لمكتبة الأعمال -->
<div class="modal-overlay" id="add-item-modal">
  <div class="modal-box">
    <h3>إضافة بند جديد لمكتبة الأعمال</h3>
    <div class="form-field" style="margin-bottom:10px;"><label>وصف العمل</label><input type="text" id="new-wi-desc"></div>
    <div class="form-grid" style="margin-bottom:10px;">
      <div class="form-field"><label>التصنيف الرئيسي</label><input type="text" id="new-wi-main" placeholder="مثال: الكهرباء"></div>
      <div class="form-field"><label>التصنيف الفرعي</label><input type="text" id="new-wi-sub" placeholder="مثال: الإنارة"></div>
    </div>
    <div class="form-grid" style="margin-bottom:10px;">
      <div class="form-field"><label>الوحدة الافتراضية</label><input type="text" id="new-wi-unit" list="unit-options"></div>
      <div class="form-field"><label>كلمات مفتاحية (اختياري)</label><input type="text" id="new-wi-keywords"></div>
    </div>
    <div class="form-field" style="margin-bottom:14px;"><label>أسماء بديلة (اختياري)</label><input type="text" id="new-wi-aliases"></div>
    <div class="modal-actions">
      <button type="button" class="btn btn-ghost" onclick="closeModal('add-item-modal')">إلغاء</button>
      <button type="button" class="btn btn-primary" onclick="submitNewWorkItem()">حفظ وإضافة للأمر</button>
    </div>
  </div>
</div>

<datalist id="unit-options">
  <option value="م²"><option value="م.ط"><option value="م³"><option value="عدد"><option value="قطعة">
  <option value="وحدة"><option value="نقطة"><option value="طقم"><option value="كيلو"><option value="طن">
  <option value="متر"><option value="يوم"><option value="مقطوعية">
</datalist>

<script>
let itemSeq = 0, paySeq = 0;
const CAN_ADD_WORK_ITEM = <%= canAddWorkItem ? 'true' : 'false' %>;
let activeRowForModal = null;

function addItemRow(desc, qty, unit, price){
  itemSeq++;
  const tbody = document.getElementById('items-body');
  const tr = document.createElement('tr');
  tr.innerHTML = `
    <td class="mono">${tbody.children.length + 1}</td>
    <td style="position:relative;">
      <input type="text" name="item_desc" class="wi-desc-input" style="width:100%;border:none;text-align:right;" value="${desc ? desc.replace(/"/g,'&quot;') : ''}" placeholder="وصف البند — اكتب للبحث">
      <div class="ac-dropdown"></div>
    </td>
    <td><input type="number" step="any" name="item_qty" style="width:100%;border:none;text-align:center;" value="${qty||''}" oninput="calcAll()"></td>
    <td><input type="text" name="item_unit" class="wi-unit-input" style="width:100%;border:none;text-align:center;" value="${unit||''}" placeholder="م²"></td>
    <td><input type="number" step="any" name="item_price" style="width:100%;border:none;text-align:center;" value="${price||''}" oninput="calcAll()"></td>
    <td class="mono item-total">0.00</td>
    <td><button type="button" class="row-del" onclick="this.closest('tr').remove(); renumber(); calcAll();">✕</button></td>
  `;
  tbody.appendChild(tr);
  attachWorkItemSearch(tr);
}

function addPayRow(desc, pct){
  paySeq++;
  const tbody = document.getElementById('pay-body');
  const tr = document.createElement('tr');
  tr.innerHTML = `
    <td class="mono">${tbody.children.length + 1}</td>
    <td><input type="text" name="pay_desc" style="width:100%;border:none;text-align:right;" value="${desc ? desc.replace(/"/g,'&quot;') : ''}" placeholder="وصف الدفعة"></td>
    <td><input type="number" step="any" name="pay_pct" style="width:100%;border:none;text-align:center;" value="${pct||''}" oninput="calcAll()"></td>
    <td class="mono pay-value">0.00</td>
    <td><button type="button" class="row-del" onclick="this.closest('tr').remove(); renumberPay(); calcAll();">✕</button></td>
  `;
  tbody.appendChild(tr);
}

function renumber(){ document.querySelectorAll('#items-body tr').forEach((r,i)=>{ r.children[0].textContent = i+1; }); }
function renumberPay(){ document.querySelectorAll('#pay-body tr').forEach((r,i)=>{ r.children[0].textContent = i+1; }); }

function fmt(n){ if(isNaN(n)) n=0; return n.toLocaleString('en-US', {minimumFractionDigits:2, maximumFractionDigits:2}); }

function calcAll(){
  let subtotal = 0;
  document.querySelectorAll('#items-body tr').forEach(tr=>{
    const qty = parseFloat(tr.querySelector('[name=item_qty]').value)||0;
    const price = parseFloat(tr.querySelector('[name=item_price]').value)||0;
    const total = qty*price;
    tr.querySelector('.item-total').textContent = fmt(total);
    subtotal += total;
  });
  const vatRate = parseFloat(document.getElementById('vat-rate').value)||0;
  const vatAmount = subtotal*vatRate/100;
  const grand = subtotal+vatAmount;
  document.getElementById('subtotal-disp').textContent = fmt(subtotal);
  document.getElementById('vat-disp').textContent = fmt(vatAmount);
  document.getElementById('grand-disp').textContent = fmt(grand);

  document.querySelectorAll('#pay-body tr').forEach(tr=>{
    const pct = parseFloat(tr.querySelector('[name=pay_pct]').value)||0;
    tr.querySelector('.pay-value').textContent = fmt(grand*pct/100);
  });
}

/* ---------------- بحث مكتبة بنود الأعمال (Autocomplete) ---------------- */
function attachWorkItemSearch(tr){
  const descInput = tr.querySelector('.wi-desc-input');
  const unitInput = tr.querySelector('.wi-unit-input');
  const dropdown = tr.querySelector('.ac-dropdown');
  let timer = null;
  let currentQuery = '';

  descInput.addEventListener('input', () => {
    const q = descInput.value.trim();
    currentQuery = q;
    clearTimeout(timer);
    if (!q) { dropdown.classList.remove('open'); dropdown.innerHTML=''; return; }
    timer = setTimeout(() => runSearch(q), 200);
  });

  descInput.addEventListener('blur', () => setTimeout(() => { dropdown.classList.remove('open'); dropdown.innerHTML=''; }, 150));

  async function runSearch(q){
    let results = [];
    try {
      const res = await fetch('/api/work-items/search?q=' + encodeURIComponent(q));
      results = await res.json();
    } catch(e) { results = []; }

    if (results.length === 0){
      let html = '<div class="ac-empty">لا توجد نتائج مطابقة</div>';
      if (CAN_ADD_WORK_ITEM) {
        html += `<div class="ac-item" style="color:var(--amber-dark); font-weight:700;" onclick="openAddWorkItemModal(this)">+ إضافة "${q.replace(/"/g,'')}" كبند جديد للمكتبة</div>`;
      }
      dropdown.innerHTML = html;
      dropdown.classList.add('open');
      dropdown.dataset.forTr = '';
      return;
    }
    dropdown.innerHTML = results.map((r,i) => `
      <div class="ac-item" data-idx="${i}">
        <span class="ac-desc">${r.description}<br><span style="font-size:10.5px;color:#aaa;">${(r.category||'')} ${r.subcategory ? '> ' + r.subcategory : ''}</span></span>
        <span class="ac-unit">${r.unit}</span>
      </div>
    `).join('');
    dropdown.classList.add('open');
    dropdown.querySelectorAll('.ac-item').forEach((el, i) => {
      el.addEventListener('mousedown', (e) => {
        e.preventDefault();
        const item = results[i];
        descInput.value = item.description;
        unitInput.value = item.unit;
        fetch('/api/work-items/' + item.id + '/use', { method: 'POST' }).catch(()=>{});
        dropdown.classList.remove('open');
        dropdown.innerHTML = '';
        loadQuickPicks();
      });
    });
  }

  // مرجع للصف الحالي عند فتح نافذة "إضافة بند جديد"
  tr.dataset.trRef = 'tr-' + Math.random().toString(36).slice(2);
  descInput.closest('tr').addEventListener('mousedown', () => { activeRowForModal = tr; });
}

function openAddWorkItemModal(el){
  const tr = el.closest('tr');
  activeRowForModal = tr;
  const q = tr.querySelector('.wi-desc-input').value.trim();
  document.getElementById('new-wi-desc').value = q;
  document.getElementById('new-wi-main').value = '';
  document.getElementById('new-wi-sub').value = '';
  document.getElementById('new-wi-unit').value = '';
  document.getElementById('new-wi-keywords').value = '';
  document.getElementById('new-wi-aliases').value = '';
  document.getElementById('add-item-modal').classList.add('open');
}

async function submitNewWorkItem(){
  const body = {
    description: document.getElementById('new-wi-desc').value.trim(),
    main_category: document.getElementById('new-wi-main').value.trim(),
    subcategory: document.getElementById('new-wi-sub').value.trim(),
    default_unit: document.getElementById('new-wi-unit').value.trim(),
    keywords: document.getElementById('new-wi-keywords').value.trim(),
    aliases: document.getElementById('new-wi-aliases').value.trim(),
  };
  if (!body.description || !body.main_category || !body.default_unit) {
    alert('الرجاء تعبئة الوصف والتصنيف الرئيسي والوحدة على الأقل.');
    return;
  }
  try {
    const res = await fetch('/api/work-items/new', {
      method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify(body)
    });
    const data = await res.json();
    if (data.ok && activeRowForModal) {
      activeRowForModal.querySelector('.wi-desc-input').value = data.item.description;
      activeRowForModal.querySelector('.wi-unit-input').value = data.item.default_unit;
    }
    closeModal('add-item-modal');
    loadQuickPicks();
  } catch(e) {
    alert('تعذر إضافة البند.');
  }
}

function closeModal(id){ document.getElementById(id).classList.remove('open'); }

/* ---------------- المستخدمة مؤخرًا + الأكثر استخدامًا ---------------- */
async function loadQuickPicks(){
  const box = document.getElementById('quick-picks');
  try {
    const [recentRes, popularRes] = await Promise.all([
      fetch('/api/work-items/recent').then(r=>r.json()),
      fetch('/api/work-items/popular').then(r=>r.json()),
    ]);
    let html = '';
    if (recentRes.length) {
      html += '<div style="margin-bottom:6px;"><b style="color:#666;">المستخدمة مؤخرًا:</b> ' +
        recentRes.map(r => `<span class="quick-chip" onclick='pickQuickItem(${JSON.stringify(r).replace(/'/g,"&apos;")})'>${r.description}</span>`).join(' ') + '</div>';
    }
    if (popularRes.length) {
      html += '<div><b style="color:#666;">الأكثر استخدامًا:</b> ' +
        popularRes.map(r => `<span class="quick-chip" onclick='pickQuickItem(${JSON.stringify(r).replace(/'/g,"&apos;")})'>${r.description}</span>`).join(' ') + '</div>';
    }
    box.innerHTML = html;
  } catch(e) { /* silent */ }
}

function pickQuickItem(item){
  addItemRow(item.description, '', item.unit);
  fetch('/api/work-items/' + item.id + '/use', { method: 'POST' }).catch(()=>{});
}

// تحميل البيانات الحالية عند التعديل
const existingItems = <%- JSON.stringify(items || []) %>;
const existingPayments = <%- JSON.stringify(payments || []) %>;

if(existingItems.length){
  existingItems.forEach(it => addItemRow(it.description, it.qty, it.unit, it.unit_price));
} else {
  for(let i=0;i<4;i++) addItemRow();
}
if(existingPayments.length){
  existingPayments.forEach(p => addPayRow(p.description, p.pct));
} else {
  for(let i=0;i<2;i++) addPayRow();
}
calcAll();
loadQuickPicks();
</script>
</body>
</html>
