# انسخ هذا الملف باسم .env عند التشغيل المحلي، أو اضبط نفس الأسماء
# كمتغيرات بيئة (Variables) داخل لوحة Railway — لا تحتاج ملف .env على Railway
# لأن DATABASE_URL تُضاف تلقائيًا بمجرد إضافة قاعدة بيانات Postgres.

# رابط الاتصال بقاعدة بيانات Postgres (تضيفه Railway تلقائيًا باسم DATABASE_URL)
DATABASE_URL=postgres://user:password@localhost:5432/tawmeed

# مفتاح سري لتشفير الجلسات — غيّره لأي نص عشوائي طويل قبل النشر الفعلي
SESSION_SECRET=change-this-to-a-long-random-secret

# الرابط الأساسي العام للموقع بعد النشر (يُستخدم لبناء رابط QR Code)
# مثال بعد النشر على Railway: https://tawmeed-production.up.railway.app
BASE_URL=http://localhost:3000

# المنفذ (Railway يضبطه تلقائيًا عبر PORT، لا تحتاج تغييره عادة)
PORT=3000
